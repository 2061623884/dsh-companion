--- /dev/null
+++ b/apps/desktop/tests/background-capabilities.spec.ts
@@ -0,0 +1,19 @@
+import { readFile } from 'node:fs/promises'
+import { expect, it } from 'vitest'
+import { createElectronBuilderConfig } from '../scripts/electron-builder-config.mjs'
+
+it.each(['win32', 'darwin'] as const)('declares background-start capability only in Windows package resources (%s)', async (platform) => {
+  const config = createElectronBuilderConfig({
+    DSH_DESKTOP_APP_ID: 'com.example.background-start',
+    DSH_DESKTOP_UNSIGNED: '1',
+    DSH_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN: 'https://policy.example.com',
+    DSH_DESKTOP_MANDATORY_UPDATE_CONFIG: JSON.stringify({ allowedAuthOrigins: ['https://login.example.com'] }),
+  }, platform, platform === 'win32' ? 'x64' : 'arm64')
+  const resource = config.extraResources.find(entry => entry.to === 'dsh-companion-capabilities.json')
+  if (platform === 'darwin') {
+    expect(resource).toBeUndefined()
+    return
+  }
+  expect(resource).toBeDefined()
+  expect(JSON.parse(await readFile(resource!.from, 'utf8'))).toEqual({ schema: 1, backgroundStart: true })
+})
