diff --git a/apps/desktop/src/launch-visibility.ts b/apps/desktop/src/launch-visibility.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e443a503bbca5170096e4f2a96511164f8790841
--- /dev/null
+++ b/apps/desktop/src/launch-visibility.ts
@@ -0,0 +1,32 @@
+/** Window presentation intent retained while the Desktop Host starts. */
+
+/**
+ * @param argv - Electron launch arguments, including the executable.
+ * @returns Whether this launch requests a hidden workspace; installer restarts still present it.
+ */
+export function requestsBackground(argv: readonly string[]): boolean {
+  return argv.includes('--background') && !argv.includes('--updated')
+}
+
+/** One application launch owns pending foreground intent and the eventual window callback. */
+export class DesktopLaunchVisibility {
+  private foreground: boolean
+  private focusOwner: (() => void) | undefined
+
+  /** @param argv - Initial Electron launch arguments. */
+  constructor(argv: readonly string[]) {
+    this.foreground = !requestsBackground(argv)
+  }
+
+  /** Whether normal workspace startup may show its window. */
+  get showInitialWorkspace(): boolean { return this.foreground }
+
+  /** Remember an explicit open, including before window creation or Host readiness. */
+  requestForeground(): void {
+    this.foreground = true
+    this.focusOwner?.()
+  }
+
+  /** @param focusOwner - Present the existing window when available; startup consumes pending intent. */
+  setFocusOwner(focusOwner: () => void): void { this.focusOwner = focusOwner }
+}
