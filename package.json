{
  "name": "dsh-companion",
  "displayName": "DSH Companion",
  "description": "An independent DeepSeek Harness sidebar for VS Code with bundled runtime and automatic code context.",
  "version": "0.3.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/2061623884/dsh-companion.git"
  },
  "homepage": "https://github.com/2061623884/dsh-companion#readme",
  "bugs": {
    "url": "https://github.com/2061623884/dsh-companion/issues"
  },
  "publisher": "local-development",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onView:dshCompanion.chat"
  ],
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.cjs",
    "package": "npm run check && npm run build && vsce package --target win32-x64 --no-dependencies --allow-missing-repository --skip-license --out ../outputs/dsh-companion-0.3.1.vsix",
    "prepare-runtime": "npm ci --prefix runtime --omit=dev --no-audit --no-fund && node scripts/prepare-runtime.mjs"
  },
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "dshCompanion",
          "title": "DSH Companion",
          "icon": "media/whale.svg"
        }
      ]
    },
    "views": {
      "dshCompanion": [
        {
          "type": "webview",
          "id": "dshCompanion.chat",
          "name": "DSH Companion"
        }
      ]
    },
    "commands": [
      {
        "command": "dshCompanion.open",
        "title": "DSH Companion: 打开右侧聊天",
        "icon": "media/whale.svg"
      },
      {
        "command": "dshCompanion.refresh",
        "title": "DSH Companion: 重新连接后台",
        "icon": "$(refresh)"
      },
      {
        "command": "dshCompanion.reference",
        "title": "DSH Companion: 引用当前文件或选区"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "dshCompanion.open",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "dshCompanion.reference",
          "when": "editorTextFocus",
          "group": "9_cutcopypaste@100"
        }
      ],
      "view/title": [
        {
          "command": "dshCompanion.refresh",
          "when": "view == dshCompanion.chat",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "DSH Companion",
      "properties": {
        "dshCompanion.diagnostics": {
          "type": "boolean",
          "default": false,
          "description": "记录发送阶段耗时及字节数，不记录代码正文或认证信息。"
        }
      }
    }
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/vscode": "1.106.0",
    "typescript": "^5.9.0",
    "esbuild": "^0.25.0",
    "@vscode/vsce": "^3.6.0"
  }
}
