{
  "name": "dsh-companion",
  "displayName": "DSH Companion",
  "description": "Use the DeepSeek Harness desktop runtime, login, settings and sessions from a VS Code sidebar.",
  "version": "0.4.0-preview.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/2061623884/dsh-companion.git"
  },
  "homepage": "https://github.com/2061623884/dsh-companion#readme",
  "bugs": {
    "url": "https://github.com/2061623884/dsh-companion/issues"
  },
  "publisher": "local-development",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onView:dshCompanion.chat"
  ],
  "scripts": {
    "check:source": "node scripts/check-source.mjs",
    "build": "node build.mjs",
    "check": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "npm run test:unit",
    "package": "npm run check && npm run build && node scripts/package-release.mjs",
    "check:release": "node scripts/check-release.mjs",
    "test:release": "node scripts/test-release.mjs",
    "prepare-runtime": "npm ci --prefix runtime --omit=dev --no-audit --no-fund && node scripts/prepare-runtime.mjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "test:unit": "npm run build && node --test tests/unit/*.test.cjs",
    "test:integration": "npm run build && npm run build:runtime && node --test --test-concurrency=1 tests/integration/*.test.cjs",
    "test:native": "npm run build && npm run build:runtime && node scripts/test-native.mjs",
    "prepare:release": "node scripts/release-candidate.mjs prepare",
    "check:candidate": "node scripts/release-candidate.mjs check",
    "preview:release": "node scripts/release-candidate.mjs preview",
    "test:desktop": "npm run build && node --test tests/desktop-integration.test.mjs"
  },
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "dshCompanion",
          "title": "DSH Companion",
          "icon": "media/whale.svg"
        }
      ]
    },
    "views": {
      "dshCompanion": [
        {
          "type": "webview",
          "id": "dshCompanion.chat",
          "name": "DSH Companion"
        }
      ]
    },
    "commands": [
      {
        "command": "dshCompanion.open",
        "title": "DSH Companion: 打开右侧聊天",
        "icon": "media/whale.svg"
      },
      {
        "command": "dshCompanion.refresh",
        "title": "DSH Companion: 重新连接后台",
        "icon": "$(refresh)"
      },
      {
        "command": "dshCompanion.reference",
        "title": "DSH Companion: 引用当前文件或选区"
      },
      {
        "command": "dshCompanion.checkUpdates",
        "title": "DSH Companion: 检查桌面端更新",
        "icon": "$(cloud-download)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "dshCompanion.open",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "dshCompanion.reference",
          "when": "editorTextFocus",
          "group": "9_cutcopypaste@100"
        }
      ],
      "view/title": [
        {
          "command": "dshCompanion.refresh",
          "when": "view == dshCompanion.chat",
          "group": "navigation"
        },
        {
          "command": "dshCompanion.checkUpdates",
          "when": "view == dshCompanion.chat",
          "group": "navigation@20"
        }
      ]
    },
    "configuration": {
      "title": "DSH Companion",
      "properties": {
        "dshCompanion.diagnostics": {
          "type": "boolean",
          "default": false,
          "description": "记录发送阶段耗时及字节数，不记录代码正文或认证信息。"
        }
      }
    }
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/semver": "^7.8.0",
    "@types/vscode": "1.106.0",
    "@types/yauzl": "3.4.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "yauzl": "3.4.0",
    "yazl": "2.5.1"
  }
}
